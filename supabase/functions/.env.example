# Secrets für die Edge Functions – Werte eintragen, Datei als supabase/functions/.env speichern
# und hochladen mit:  npx supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL und SUPABASE_SERVICE_ROLE_KEY stellt Supabase automatisch bereit.)

SITE_URL=https://www.deine-domain.de
APP_NAME=ProfilRing
ALLOWED_ORIGINS=https://www.deine-domain.de,http://localhost:8080

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PREMIUM=price_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_TEAM=price_...
# Optional: Rechnungen für Einmalkäufe / Stripe Tax
STRIPE_INVOICES=true
STRIPE_AUTOMATIC_TAX=false

# Optional, aber empfohlen: E-Mail-Versand (Lizenzschlüssel, Kontaktformular) über Resend
RESEND_API_KEY=re_...
EMAIL_FROM=ProfilRing <hallo@deine-domain.de>
CONTACT_EMAIL=hallo@deine-domain.de
